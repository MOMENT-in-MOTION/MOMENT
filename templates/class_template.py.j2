{% extends "base_template.py.j2" %}
{% from "macros/field_macro.j2" import render_field %}
{'#- This template generates Python dataclasses based on the provided class descriptors. It can be configured using the api_config to conform to user specific api design preferences -#}
{% block imports %}
from __future__ import annotations
{% if enums is defined and enums|length > 0 %}
{% if api_config.RelativeImports == "true" %}
from .enum_code import *
{% else %}
from enum_code import *
{% endif %}
{% endif %}
{% endblock %}

{% block body %}
{% for cls in classes %}
{% if api_config.Inheritance == "native" %}
class {{ cls.class_name }}({% for base in cls.inherits %}{{ base }}{% if not loop.last %}, {% endif %}{% endfor %}):
{% else %}
class {{ cls.class_name }}:
{% endif %}
    {# Generate a docstring listing the fields and their types #}
    """
    Generated dataclass for {{ cls.class_name }} 
    Attributes:
    {% for f in cls.sorted_fields %}
        {% set _attr = ("__" if api_config.UseDoubleUnderscore == "true" else "_" if api_config.StrictPrivacy == "true" else "") + f.field_name %}
        {{ _attr }}: {{ f.type_hint }}{% if f.has_default %} = {{ f.rendered_default }}{% endif %} 
        {% if f.multiplicity_lower_bound is not none and f.multiplicity_upper_bound is not none %}
        {% if f.multiplicity_lower_bound == f.multiplicity_upper_bound %}
            This field has a fixed multiplicity of {{ f.multiplicity_lower_bound }} elements
        {% else %}
            has to be between {{ f.multiplicity_lower_bound }} and {{ f.multiplicity_upper_bound }} elements
        {% endif %}
        {% endif %}
        {% if not loop.last %}
        {% endif %}
    {% endfor %}
    """
    {% for f in cls.sorted_fields %}
    {#- If strict privacy is enabled and this is a non-association field, make it private by prefixing with __ -#}
    {% if api_config.StrictPrivacy == "true" %}
        {% if api_config.UseDoubleUnderscore == "true" %}
    __{{ render_field(f) }}
        {% if f.multiplicity_lower_bound is not none and f.multiplicity_upper_bound is not none %}
        {% endif %}
        {% else %}
    _{{ render_field(f) }}
        {% if f.multiplicity_lower_bound is not none and f.multiplicity_upper_bound is not none %}
        {% endif %}
        {% endif %}
    {%- else %}
    {{ render_field(f) }}
    {% if f.multiplicity_lower_bound is not none and f.multiplicity_upper_bound is not none %}
        {% endif %}
    {% endif %}
    _{{f.field_name}}_multiplicity_lower_bound : int
    _{{f.field_name}}_multiplicity_upper_bound : int
    {% endfor %}

    {% if api_config.GenerateConstructors == "true" %}
    def __init__(self
    {%- for f in cls.sorted_fields -%}
        , {{f.field_name}}: {{f.type_hint}}{% if f.has_default %} = {{f.rendered_default}}{% endif %}
    {%- endfor -%}
    ) -> None:
        """Generated constructor for {{ cls.class_name }}"""
        {% for f in cls.sorted_fields %}
        {% set _attr = ("__" if api_config.UseDoubleUnderscore == "true" else "_" if api_config.StrictPrivacy == "true" else "") + f.field_name %}
        {% if f.multiplicity.lower is not none and f.multiplicity.upper is not none %}
        self._{{f.field_name}}.multiplicity.lower = {{f.multiplicity.lower}}
        self._{{f.field_name}}.multiplicity.upper = {{f.multiplicity.upper}}
        if not (self._{{f.field_name}}.multiplicity.lower <= len({{f.field_name}}) <= self._{{f.field_name}}.multiplicity.upper):
            raise ValueError(f"Field '{{_attr}}' must have between {{f.multiplicity.lower}} and {{f.multiplicity.upper}} elements, got {len({{f.field_name}})}")
        {% endif %}
        
        self.{{_attr}} = {{f.field_name}}
        {% endfor %}
    {% endif %}

    {% for f in cls.sorted_fields %}
    {% set _attr = ("__" if api_config.UseDoubleUnderscore == "true" else "_" if api_config.StrictPrivacy == "true" else "") + f.field_name %}

    {#- Generate getters and setters for non-association fields based on configuration -#}
    {% if api_config.GenerateGetters == "true" %}
    {% if api_config.NamingConvention == "camelCase" %}
    def get{{ f.field_name[0] | upper }}{{ f.field_name[1:] }}(self) -> {{f.type_hint}}:
    {% else %}
    def get_{{f.field_name}}(self) -> {{f.type_hint}}:
    {% endif %}
        """Generated getter for {{_attr}}"""
        if self.{{_attr}} is None:
            raise ValueError("Field '{{_attr}}' has not been initialized.")
        return self.{{_attr}}
    {% endif %}

    {% if api_config.GenerateSetters == "true" %}
    {% if api_config.NamingConvention == "camelCase" %}
    def set{{ f.field_name[0] | upper }}{{ f.field_name[1:] }}(self, value: {{f.type_hint}}) -> None:
    {% else %}
    def set_{{f.field_name}}(self, value: {{f.type_hint}}) -> None:
    {% endif %}
        """
        Generated setter for {{_attr}}

        Args:
            value: The new value to assign to the "{{_attr}}" attribute
        """
        {% if api_config.ExplicitTypeSafety == "true" %}
        {% if f.multiplicity.is_optional %}
        if value is not None:
            {% if f.multiplicity.is_list %}
            if not isinstance(value, list) or not all(isinstance(i, {{f.base_type}}) for i in value):
                raise TypeError(f"Expected type list[{{f.base_type}}] or None for field '{{_attr}}', got {type(value)}")
            {% else %}
            if not isinstance(value, {{f.base_type}}):
                raise TypeError(f"Expected type {{f.base_type}} or None for field '{{_attr}}', got {type(value)}")
            {% endif %}
        {% else %}
        {% if f.multiplicity.is_list or (f.multiplicity_lower_bound is not none and f.multiplicity_upper_bound is not none) %}
        if not isinstance(value, list) or not all(isinstance(i, {{f.base_type}}) for i in value):
            raise TypeError(f"Expected type list[{{f.base_type}}] for field '{{_attr}}', got {type(value)}")

        if not (self._{{f.field_name}}_multiplicity_lower_bound <= len(value) <= self._{{f.field_name}}_multiplicity_upper_bound):
            raise ValueError(f"Field '{{_attr}}' must have between {{f.multiplicity_lower_bound}} and {{f.multiplicity_upper_bound}} elements, got {len(value)}")
    
        {% else %}
        if not isinstance(value, {{f.base_type}}):
            raise TypeError(f"Expected type {{f.base_type}} for field '{{_attr}}', got {type(value)}")
        {% endif %}
        {% endif %}
        {% endif %}
        self.{{_attr}} = value
    {% endif %}

    {% endfor %}

    def to_dict(self) -> dict:
        """Generated serialization method for {{ cls.class_name }}"""
        result = {}
        {% for f in cls.sorted_fields %}
        {% set _attr = ("__" if api_config.UseDoubleUnderscore == "true" else "_" if api_config.StrictPrivacy == "true" else "") + f.field_name %}
        {% set _key = f.field_name %}
        {% if f.multiplicity.is_list %}
        {% if f.multiplicity.is_optional %}
        result["{{ _key }}"] = (
            [v.to_dict() if hasattr(v, "to_dict") else (v.value if hasattr(v, "value") else v) for v in self.{{ _attr }}]
            if self.{{ _attr }} is not None else None
        )
        {% else %}
        result["{{ _key }}"] = (
            [v.to_dict() if hasattr(v, "to_dict") else (v.value if hasattr(v, "value") else v) for v in self.{{ _attr }}]
        )
        {% endif %}
        {% elif f.multiplicity.is_optional %}
        result["{{ _key }}"] = (
            self.{{ _attr }}.to_dict() if hasattr(self.{{ _attr }}, "to_dict")
            else (self.{{ _attr }}.value if hasattr(self.{{ _attr }}, "value") else self.{{ _attr }})
            if self.{{ _attr }} is not None else None
        )
        {% else %}
        result["{{ _key }}"] = (
            self.{{ _attr }}.to_dict() if hasattr(self.{{ _attr }}, "to_dict")
            else (self.{{ _attr }}.value if hasattr(self.{{ _attr }}, "value") else self.{{ _attr }})
        )
        {% endif %}
        {% endfor %}
        return result

{% if not loop.last %}
{% endif %}
{% endfor -%}
{% endblock -%}
